rules_version = '2';

// FighterEdge Firestore security rules.
// Users can read and maintain their own profile document, but billing fields
// are server-owned. A trusted backend/webhook using the Admin SDK should write
// plan and entitlement state.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isFreeProfileCreate();
      allow update: if isOwner(uid) && billingFieldsUnchanged();
      allow delete: if false;

      match /weights/{entryId} {
        allow read, write: if isOwner(uid);
      }

      match /meals/{dateKey} {
        allow read, write: if isOwner(uid);
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /nutritionProfile/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /nutritionTargets/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isFreeProfileCreate() {
      return !('plan' in request.resource.data) ||
        request.resource.data.plan == 'free';
    }

    function billingFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'entitlement',
        'entitlements',
        'billing',
        'billingProvider',
        'customerId',
        'subscriptionId',
        'productId',
        'expiresAt',
        'gracePeriodEndsAt',
      ]);
    }
  }
}
