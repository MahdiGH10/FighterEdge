rules_version = '2';

// FighterEdge Firestore security rules.
// Each user can read/write ONLY their own profile document. Everything else is
// denied by default.
//
// NOTE: for the current no-payments build the owner may also write their own
// `plan` field (so the demo "Upgrade" works). Before shipping paid Pro, replace
// the users rule with the stricter version in docs/firebase_setup.md §5 that
// forbids client `plan` writes, and set the plan from a verified payment
// webhook via a Cloud Function (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
