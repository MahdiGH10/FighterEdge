<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (audit S-6). The Firestore offline cache holds health data
     (weight, meals, measurements), and shared preferences hold food memory
     and streak state. None of it goes into cloud backups or device-to-device
     transfers. The account's data lives in Firestore, so signing in on the
     new device restores it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
